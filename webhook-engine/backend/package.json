{
  "name": "webhook-engine-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
