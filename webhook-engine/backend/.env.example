NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://webhooks:webhooks@localhost:5432/webhooks?schema=public
REDIS_URL=redis://localhost:6379

# Shared secret for the management API (min 16 chars). Generate: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

RATE_LIMIT_PER_MINUTE=300
INGEST_RATE_LIMIT_PER_MINUTE=1200

# Delivery engine
WEBHOOK_TIMEOUT_MS=10000
WORKER_CONCURRENCY=20
# Delay (seconds) before retry N. Length + 1 = max attempts. Default = 1m, 5m, 15m, 60m -> 5 attempts.
BACKOFF_SCHEDULE_SECONDS=60,300,900,3600
RECONCILE_INTERVAL_MS=30000

# SSRF guard: leave false in production. Set true only to deliver to localhost in local demos.
ALLOW_PRIVATE_TARGETS=false
